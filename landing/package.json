{
  "name": "landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/angaliawebapp/landing/ && yarn copy-html-entry",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "copy-html-entry": "cp ../angaliawebapp/public/landing/index.html ../angaliawebapp/www/landing.html"
  },
  "dependencies": {
    "antd": "^5.17.4",
    "frappe-react-sdk": "^1.7.0",
    "isotope-layout": "^3.0.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.5",
    "react-hook-form-input": "^1.1.10",
    "react-iframe": "^1.8.5",
    "react-router-dom": "^6.23.1",
    "sass": "^1.77.2",
    "socket.io-client": "^4.7.5",
    "swiper": "^11.1.3",
    "wow.js": "^1.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0"
  }
